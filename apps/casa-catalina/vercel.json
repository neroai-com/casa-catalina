{
  "rewrites": [
    { "source": "/api/availability", "destination": "https://catalina-rentals-cms.vercel.app/api/public/casa-catalina/availability" },
    { "source": "/api/request", "destination": "https://catalina-rentals-cms.vercel.app/api/public/casa-catalina/request" },
    { "source": "/api/content", "destination": "https://catalina-rentals-cms.vercel.app/api/public/casa-catalina/content" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/frames/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
